    "minimapSlider.activeBackground": "#8AA2BC77",
    "editor.foreground": "#DCE3ED",
    "editorLineNumber.foreground": "#657183",
    "editorLineNumber.activeForeground": "#E6EDF5",
    "editorCursor.foreground": "#66C8FF",
    "editor.selectionBackground": "#264E70",
    "editor.lineHighlightBackground": "#FFFFFF08",
    "activityBar.background": "#242C38",
    "activityBar.foreground": "#F0F5FA",
