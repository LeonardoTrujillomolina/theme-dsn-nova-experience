    "notifications.foreground": "#172330",
    "editorWarning.foreground": "#8F6A00",
    "list.warningForeground": "#8F6A00",
    "gitDecoration.modifiedResourceForeground": "#8F6A00",
    "editorGutter.modifiedBackground": "#8F6A00",
    "notificationsWarningIcon.foreground": "#8F6A00",
    "problemsWarningIcon.foreground": "#8F6A00",
    "editorOverviewRuler.warningForeground": "#8F6A00"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6B7A8D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables and properties",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#1B2733"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#41556B"
      }
    },
    {
      "name": "DSN cyan",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "entity.name.tag",
        "punctuation.definition.tag",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#0A7C9E"
      }
    },
    {
      "name": "DSN blue",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function",
        "variable.other.readwrite.alias",
        "meta.import variable.other.readwrite",
        "meta.import entity.name.type"
      ],
      "settings": {
        "foreground": "#1F5FD0"
      }
    },
    {
      "name": "DSN purple",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7A4DB0"
      }
    },
    {
      "name": "DSN green",
      "scope": [
        "string",
        "string.quoted",
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#1E7F4F"
      }
    },
    {
      "name": "DSN orange",
      "scope": [
        "constant.numeric",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#B85A00"
      }
    },
    {
      "name": "DSN red",
      "scope": [
        "constant.language",
        "constant.other",
        "support.constant",
        "variable.other.constant",
        "invalid"
      ],
      "settings": {
        "foreground": "#C02339"
      }
    },
    {
      "name": "DSN gold",
      "scope": [
        "invalid.deprecated",
        "markup.changed",
        "markup.deprecated"
      ],
      "settings": {
        "foreground": "#8F6A00"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#1B2733",
    "variable": "#1B2733",
    "keyword": "#0A7C9E",
    "function": "#1F5FD0",
    "method": "#1F5FD0",
    "class": "#7A4DB0",
    "type": "#7A4DB0",
    "interface": "#7A4DB0",
    "enum": "#7A4DB0",
    "namespace": "#7A4DB0",
    "struct": "#7A4DB0",
    "typeParameter": "#7A4DB0",
    "property": "#7A4DB0",
    "decorator": "#B85A00",
    "number": "#B85A00",
    "enumMember": "#C02339",
    "variable.readonly": "#C02339",
    "variable.defaultLibrary": "#C02339"
  }
}